# Composer installs this repo's PHP package from GitHub's archive of a tag;
# keep the Go server, tooling and PHP tests out of that archive.
/cmd            export-ignore
/internal       export-ignore
/pkg            export-ignore
/deploy         export-ignore
/.github        export-ignore
/go.mod         export-ignore
/go.sum         export-ignore
/php/tests      export-ignore
/php/phpunit.xml.dist export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore

{
  "uid": "qsrv-queue",
  "title": "qsrv / Queue",
  "description": "One queue in detail: state, throughput, failures, retries.",
  "tags": [
    "qsrv"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(qsrv_build_info, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(qsrv_build_info, job)",
        "regex": "",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "description": "",
        "current": {},
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(qsrv_build_info{job=~\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(qsrv_build_info{job=~\"$job\"}, instance)",
        "regex": "",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "description": "",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": ".+"
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(qsrv_queue_info{job=~\"$job\", instance=~\"$instance\"}, queue)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(qsrv_queue_info{job=~\"$job\", instance=~\"$instance\"}, queue)",
        "regex": "/^([^/]+)\\//",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "description": "The part of queue names before the slash.",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allValue": ".+"
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(qsrv_queue_info{job=~\"$job\", instance=~\"$instance\", queue=~\"($tenant)/.+\"}, queue)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(qsrv_queue_info{job=~\"$job\", instance=~\"$instance\", queue=~\"($tenant)/.+\"}, queue)",
        "regex": "",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "description": "",
        "current": {},
        "options": [],
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "qsrv alerts firing",
        "expr": "ALERTS{alertname=~\"Qsrv.*\", alertstate=\"firing\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{queue}}{{instance}} severity={{severity}}",
        "tagKeys": "severity,alertname",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "qsrv dashboards",
      "type": "dashboards",
      "tags": [
        "qsrv"
      ],
      "asDropdown": true,

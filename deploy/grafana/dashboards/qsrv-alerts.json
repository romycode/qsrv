          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ALERTS{alertname=~\"Qsrv.*\", alertstate=\"pending\"}) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
